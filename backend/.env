# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_sample@ep-quick-mode-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Configuration
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Authentication
